# watch3r — TEST region stack environment
#
# These are the environment variables the Portainer stack for the `test`
# region must define. Copy the values below into the Portainer stack's
# "Environment variables" section (Stacks -> watch3r-test -> Editor).
#
# Do NOT commit real secrets. This file is a template only. Secrets
# (BETTER_AUTH_SECRET, TMDB_API_READ_ACCESS_TOKEN, POSTGRES_PASSWORD,
# MINIO_ROOT_PASSWORD) live only in Portainer.

# --- Region identity ---------------------------------------------------------
DEPLOY_ENV=test
# Moving tag CI pushes to and Portainer pulls. CI also pushes an immutable
# test-<sha> tag for traceability.
IMAGE_TAG=test
# Forgejo registry namespace (owner). Override only if it differs.
REGISTRY=orbiter.taild7aa61.ts.net/jordan

# --- Host port mappings (prefixed with 1 to leave room for a prod region) ----
WEB_PORT=13001
SERVER_PORT=13000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
POSTGRES_PORT=15432

# --- Public URLs (Tailscale hostname of the deploy host) ---------------------
# NOTE: VITE_SERVER_URL is NOT set here — it is baked into the web image at
# build time by CI. It must match SERVER_PORT below:
#   VITE_SERVER_URL = http://orbiter.taild7aa61.ts.net:13000
BETTER_AUTH_URL=http://orbiter.taild7aa61.ts.net:13000
CORS_ORIGIN=http://orbiter.taild7aa61.ts.net:13001
S3_PUBLIC_ENDPOINT=http://orbiter.taild7aa61.ts.net:19000
S3_PUBLIC_URL=http://orbiter.taild7aa61.ts.net:19000

# --- Object storage ----------------------------------------------------------
S3_REGION=us-east-1
S3_AVATARS_BUCKET=watch3r-avatars
S3_COVERS_BUCKET=watch3r-covers

# --- Secrets (set real values in Portainer, never commit) --------------------
# >= 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars
# TMDB v4 read access token (JWT).
TMDB_API_READ_ACCESS_TOKEN=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=watch3r
MINIO_ROOT_PASSWORD=CHANGE_ME
