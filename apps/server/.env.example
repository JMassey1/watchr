# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# DATABASE_URL=

# Object storage (S3-compatible). Defaults target the local MinIO from docker-compose.
# For production, point these at Cloudflare R2 (endpoint, keys, and public/CDN URL).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=watch3r-avatars
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/watch3r-avatars
