{
  "name": "watch3r",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@aws-sdk/client-s3": "^3.960.0",
      "@aws-sdk/s3-request-presigner": "^3.960.0",
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.27",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.6.23",
      "lucide-react": "^1.23.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "@trpc/tanstack-react-query": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "@tanstack/react-query": "^5.101.2",
      "@tanstack/react-form": "^1.33.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.2",
      "tailwind-merge": "^3.6.0",
      "@better-auth/expo": "1.6.23"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @watch3r/db",
    "db:studio": "turbo run db:studio -F @watch3r/db",
    "db:generate": "turbo run db:generate -F @watch3r/db",
    "db:migrate": "turbo run db:migrate -F @watch3r/db",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@watch3r/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@watch3r/config": "workspace:*",
    "turbo": "^2.10.2",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.14"
}
